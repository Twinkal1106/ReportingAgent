# FedEx API MCP Server Configuration Example
# Copy this file to .env and fill in your actual values

INTERNAL_API_BASE_URL=https://your-api-gateway-url/
INTERNAL_API_KEY=your_bearer_token_here
MCP_SERVER_NAME=fedex-reporting-mcp-server
MCP_SERVER_PORT=8001
VERIFY_SSL=false
LOG_LEVEL=INFO
USER_DISPLAY_NAME=Twinkal
